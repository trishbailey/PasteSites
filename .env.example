# Copy to .env for local runs. Leave secrets blank in git.
# The app refuses sign-in until APP_ACCESS_PASSWORD is set. There is no default.

APP_ACCESS_PASSWORD=
# Required. At least 32 random characters. The process refuses to start without it.
# Do not derive this from the access password.
SESSION_SECRET=
SEARCHES_PER_HOUR=8
IP_SEARCHES_PER_HOUR=12
LOGIN_ATTEMPTS_PER_HOUR=10

# Optional providers. Blank means that provider reports "needs key".
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GITHUB_TOKEN=
HIBP_API_KEY=
INTELX_API_KEY=
INTELX_API_URL=https://free.intelx.io
INTELX_BUCKETS=pastes,leaks.public
PASTEBIN_SCRAPING_ENABLED=
PASTEBIN_SCRAPING_LIMIT=25
PASTEBIN_SCRAPE_DELAY=1
